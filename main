class mcs_kvcv_aao{

		public:
		
		double norm_cdf(double x, double mu, double sigma)
				{return(0.5 * (1 + std::erf((x - mu) / (std::sqrt(2) * sigma))));}
				
		mcs_kvcv_aao(double in_ft, int in_bs, int in_mcr, double in_ir, double in_v, double in_sp, double in_ip, Eigen::RowVectorXd in_stockprc, unsigned long long seed = std::random_device{}()): 
		gen(seed), n_brownian_stp(in_bs), n_mcs_run(in_mcr), p_final_t(in_ft), p_int_rt(in_ir), p_vol(in_v), p_strk_prc(in_sp), p_init_prc(in_ip), v_stock_prcs(in_stockprc)
		{
				double _sd = std::sqrt(p_final_t / n_brownian_stp);
				Eigen::MatrixXd m_brownian_nz = Eigen::MatrixXd::Zero(n_mcs_run * 0.5, n_brownian_stp).unaryExpr([this, _sd](double){return(gaussian(gen) * _sd);});
				for(int i = 1; i < m_brownian_nz.cols(); i++)
						{m_brownian_nz.col(i) += m_brownian_nz.col(i-1);}
				Eigen::MatrixXd m_brownian_az(m_brownian_nz.rows(), m_brownian_nz.cols() + 1);
				m_brownian_az << Eigen::MatrixXd::Zero(n_mcs_run * 0.5, 1), m_brownian_nz;
				Eigen::MatrixXd m_brownian_l(m_brownian_az.rows() * 2, m_brownian_az.cols());
				m_brownian_l << m_brownian_az, (-1) * m_brownian_az; 
				m_brownian = m_brownian_l;
				v_timesteps = Eigen::VectorXd::LinSpaced(n_brownian_stp + 1, 0, p_final_t);
				
				gao_alpha_t = std::exp(0.5 * p_final_t * (p_int_rt - 0.5 * std::pow(p_vol, 2)));
				gamma_t = std::exp(-0.5 * p_int_rt * p_final_t - (std::pow(p_vol, 2) * p_final_t) / 12);
				lambda_t = (p_final_t / p_vol) * std::log(p_strk_prc / p_init_prc) - (std::pow(p_final_t, 2) / (2 * p_vol)) * (p_int_rt - 0.5 * std::pow(p_vol, 2));
		}
		
		double sim_run()
		{
				double _init_cap = kemna_vorst_block_prc(m_brownian);
				double _prev_dlt = (n_brownian_stp / (n_brownian_stp + 1)) * kemna_vorst_block_dlt(m_brownian);
				double _debt_ira = _init_cap - p_init_prc * _prev_dlt;
				for(int i = 2; i <= n_brownian_stp; i++)
				{
						Eigen::MatrixXd _m_new_brownian = brownian_cond(i);
						_debt_ira = _debt_ira * std::exp(p_int_rt * p_final_t / n_brownian_stp);
						double _new_dlt = kemna_vorst_block_dlt(_m_new_brownian);
						double _scaled = ((n_brownian_stp - i + 1)*1.0) / ((n_brownian_stp + 1)*1.0);
						_debt_ira = _debt_ira - v_stock_prcs(i-1) * (_scaled * _new_dlt - _prev_dlt);
						_prev_dlt = _scaled * _new_dlt;
				}
				return(_prev_dlt / (n_brownian_stp + 1) * v_stock_prcs(Eigen::last) + _debt_ira);
		}
		
		private:

				int n_brownian_stp;
				int n_mcs_run;
				
				double p_final_t;
				double p_int_rt;
				double p_vol;
				double p_strk_prc;
				double p_init_prc;
		
				std::mt19937_64 gen;
				std::normal_distribution<double> gaussian{0.0, 1.0};
				
				Eigen::MatrixXd m_brownian;
				Eigen::VectorXd v_timesteps;
				Eigen::RowVectorXd v_stock_prcs;
		
				double gao_alpha_t;
				double gamma_t;
				double lambda_t;

		Eigen::RowVectorXd brownian_cond_conv(int _in_n)
		{
				Eigen::RowVectorXd _stock_cond = v_stock_prcs.leftCols(_in_n);
				Eigen::RowVectorXd _brownian_cond = (_stock_cond / p_init_prc).array().log() / p_vol - v_timesteps.head(_in_n).transpose() / p_vol * (p_int_rt - 0.5 * std::pow(p_vol, 2));
				return(_brownian_cond);
		}
		Eigen::MatrixXd brownian_cond(int _in_n)
		{
				Eigen::RowVectorXd _v_brownian_cond = brownian_cond_conv(_in_n);
				Eigen::MatrixXd _m_brownian_end = m_brownian.leftCols(n_brownian_stp - _in_n + 1).array() + _v_brownian_cond(Eigen::last);
				Eigen::MatrixXd _m_brownian_beg = _v_brownian_cond.replicate(n_mcs_run, 1);
				Eigen::MatrixXd _brownian_cond(_m_brownian_beg.rows(), _m_brownian_beg.cols() + _m_brownian_end.cols());
				_brownian_cond << _m_brownian_beg, _m_brownian_end;
				return(_brownian_cond);			
		}
		
		double cfs_gao_prc()
		{
				double _sd = std::sqrt(std::pow(p_final_t, 3) / 3);
				double _mean = p_vol * std::pow(p_final_t, 2) / 3;
				double _cfs_gao_prc = p_init_prc * gamma_t * (1 - norm_cdf(lambda_t, _mean, _sd)) - p_strk_prc * std::exp(-p_int_rt * p_final_t) * (1 - norm_cdf(lambda_t, 0, _sd));
				return(_cfs_gao_prc);
		}
		
		double cfs_gao_dlt()
		{
				double _sd = std::sqrt(std::pow(p_final_t, 3) / 3);
				double _mean = p_vol * std::pow(p_final_t, 2) / 3;
				double _term_phi = (1 / p_vol) * std::sqrt(3 / (2 * p_final_t * std::numbers::pi));
				double _term_a = gamma_t * (1 - norm_cdf(lambda_t, _mean, _sd));
				double _term_b = gamma_t * _term_phi * std::exp(-3 / (2 * std::pow(p_final_t, 3)) * (std::pow(lambda_t, 2) - (2.0 / 3.0) * lambda_t * p_vol * std::pow(p_final_t, 2) + std::pow(p_vol, 2) * std::pow(p_final_t, 4) / 9));
				double _term_c = (_term_phi * p_strk_prc * std::exp(-p_int_rt * p_final_t) / p_init_prc) * std::exp(-3 * std::pow(lambda_t, 2) / (2 * std::pow(p_final_t, 3)));
				return(_term_a + _term_b - _term_c);
		}

		Eigen::MatrixXd step_t(const Eigen::MatrixXd _in_m_brownian)
		{
				Eigen::MatrixXd w_a = _in_m_brownian.leftCols(_in_m_brownian.cols() - 1);
				Eigen::MatrixXd w_b = _in_m_brownian.rightCols(_in_m_brownian.cols() - 1);
				return((p_final_t / n_brownian_stp) * (w_a + w_b));
		}
		Eigen::MatrixXd gao_beta_t(const Eigen::MatrixXd _in_m_brownian)
				{return((step_t(_in_m_brownian).rowwise().sum() * p_vol / (2 * p_final_t)).array().exp());}
		Eigen::VectorXd gao_s_bar(const Eigen::MatrixXd _in_m_brownian)
				{return(p_init_prc * gao_alpha_t * gao_beta_t(_in_m_brownian));}
		Eigen::VectorXd pd_gao_prc(const Eigen::MatrixXd _in_m_brownian)
				{return(std::exp(-p_int_rt * p_final_t) * (gao_s_bar(_in_m_brownian).array() - p_strk_prc).max(0.0));}
		
		Eigen::VectorXd pd_gao_dlt(const Eigen::MatrixXd _in_m_brownian)
		{
				Eigen::VectorXd _s_bar = gao_s_bar(_in_m_brownian);
				Eigen::VectorXd _pd_gao_dlt = std::exp(-p_final_t * p_int_rt) * (_s_bar.array() / p_init_prc) * (_s_bar.array() - p_strk_prc > 0).cast<double>();
				return(_pd_gao_dlt);
		}

		Eigen::MatrixXd delta_t(const Eigen::MatrixXd _in_m_brownian)
		{
				Eigen::MatrixXd w_a = _in_m_brownian.leftCols(_in_m_brownian.cols() - 1);
				Eigen::MatrixXd w_b = _in_m_brownian.rightCols(_in_m_brownian.cols() - 1);
				return((w_b - w_a) / (p_final_t / n_brownian_stp));
		}
		Eigen::MatrixXd aao_alpha_t(const Eigen::MatrixXd _in_m_brownian)
				{return((p_int_rt - 0.5 * std::pow(p_vol, 2) + delta_t(_in_m_brownian).array() * p_vol).matrix());}
		Eigen::MatrixXd aao_beta_t(Eigen::MatrixXd _in_m_brownian)
		{
				Eigen::MatrixXd _w_a = _in_m_brownian.leftCols(_in_m_brownian.cols() - 1);
				Eigen::VectorXd _t_a = v_timesteps.topRows(v_timesteps.rows() - 1);
				Eigen::MatrixXd _delta = delta_t(_in_m_brownian);
				return(-p_vol * (_delta * _t_a.asDiagonal() - _w_a));
		}
		Eigen::MatrixXd aao_s_bar(const Eigen::MatrixXd _in_m_brownian)
		{
				Eigen::MatrixXd alpha = aao_alpha_t(_in_m_brownian);
				Eigen::MatrixXd beta = aao_beta_t(_in_m_brownian);
				Eigen::MatrixXd step = alpha.array().inverse() * beta.array().exp() * 
						((alpha * v_timesteps.bottomRows(v_timesteps.rows() - 1).asDiagonal()).array().exp() - 
						(alpha * v_timesteps.topRows(v_timesteps.rows() - 1).asDiagonal()).array().exp());
				return(step.rowwise().sum() * p_init_prc / p_final_t);
		}
		Eigen::VectorXd pd_aao_prc(const Eigen::MatrixXd _in_m_brownian)
				{return(std::exp(-p_int_rt * p_final_t) * (aao_s_bar(_in_m_brownian).array() - p_strk_prc).max(0.0));}
				
		Eigen::VectorXd pd_aao_dlt(const Eigen::MatrixXd _in_m_brownian)
		{
				Eigen::VectorXd _s_bar = aao_s_bar(_in_m_brownian);
				Eigen::VectorXd _pd_aao_dlt = std::exp(-p_final_t * p_int_rt) * (_s_bar.array() / p_init_prc) * (_s_bar.array()  - p_strk_prc > 0).cast<double>();
				return(_pd_aao_dlt);
		}
		
		double kemna_vorst_block_prc(const Eigen::MatrixXd _in_m_brownian)
		{
				Eigen::VectorXd _v_pd_gao_prc = pd_gao_prc(_in_m_brownian);
				Eigen::VectorXd _v_pd_aao_prc = pd_aao_prc(_in_m_brownian);
				double _cfs_gao_prc_mean = cfs_gao_prc();
				double _pd_gao_prc_mean = _v_pd_gao_prc.mean();
				double _pd_aao_prc_mean = _v_pd_aao_prc.mean();
				double _var_gao_prc = (_v_pd_gao_prc - _pd_gao_prc_mean).squaredNorm();
				double _c = _var_gao_prc > 0 ? (_v_pd_aao_prc - _pd_aao_prc_mean).dot(_v_pd_gao_prc - _pd_gao_prc_mean) / _var_gao_prc : 0;
				return(_pd_aao_prc_mean - _c * (_pd_gao_prc_mean - _cfs_gao_prc_mean));
		}
		
		double kemna_vorst_block_dlt(const Eigen::MatrixXd _in_m_brownian)
		{
				Eigen::VectorXd _v_pd_gao_dlt = pd_gao_dlt(_in_m_brownian);
				Eigen::VectorXd _v_pd_aao_dlt = pd_aao_dlt(_in_m_brownian);
				double _cfs_gao_dlt_mean = cfs_gao_dlt();
				double _pd_gao_dlt_mean = _v_pd_gao_dlt.mean();
				double _pd_aao_dlt_mean = _v_pd_aao_dlt.mean();
				double _var_gao_dlt = (_v_pd_gao_dlt - _pd_gao_dlt_mean).squaredNorm();
				double _c = _var_gao_dlt > 0 ? (_v_pd_aao_dlt - _pd_aao_dlt_mean).dot(_v_pd_gao_dlt - _pd_gao_dlt_mean) / _var_gao_dlt : 0;
				return(_pd_aao_dlt_mean - _c * (_pd_gao_dlt_mean - _cfs_gao_dlt_mean));
		}
};